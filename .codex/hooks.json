{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; python3 \"$root/.codex/hooks/check_backend.py\"",
            "timeout": 600,
            "statusMessage": "Checking backend architecture, formatting, and lint"
          },
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; python3 \"$root/.codex/hooks/check_frontend.py\"",
            "timeout": 600,
            "statusMessage": "Checking frontend formatting and lint"
          }
        ]
      }
    ]
  }
}
