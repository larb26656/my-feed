{
  "name": "my-feed-webapp",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "test": "vitest run",
    "openapi:generate": "openapi-typescript ../backend/internal/platform/apidocs/swagger.json -o src/lib/api/schema.d.ts",
    "openapi:check": "openapi-typescript ../backend/internal/platform/apidocs/swagger.json -o /tmp/my-feed-openapi-schema.d.ts && diff -u src/lib/api/schema.d.ts /tmp/my-feed-openapi-schema.d.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/react-table": "^8.21.3",
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^6.2.5",
    "react-hook-form": "^7.92.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-themes": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "storybook": "^10.6.8",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
