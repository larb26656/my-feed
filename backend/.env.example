DATABASE_PATH=data/my-feed.db
HTTP_ADDR=:8080
# Required Reader login credentials and JWT signing secret.
MY_FEED_USERNAME=admin
MY_FEED_PASSWORD=changeme
MY_FEED_JWT_SECRET=change-me-to-a-long-random-string
# Optional shared Bearer for scripts / MCP. Empty = JWT login only.
MY_FEED_API_KEY=
# Access ~15m, refresh ~7d (Go duration strings).
MY_FEED_ACCESS_TTL=15m
MY_FEED_REFRESH_TTL=168h
FETCH_SCHEDULE_INTERVAL=15m
FETCH_RETRY_BACKOFF=1m
FETCH_EXECUTOR_POLL=2s
